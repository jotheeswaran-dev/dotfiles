# frozen_string_literal: true

# file location: ${HOME}/Brewfile

# This file is used along with the `brew bundle` command to ensure that required packages and apps are installed.
# Also can be used to ensure that any package/apps that were installed as experimentation are uninstalled from the system.
# For a more detailed explanation of the philosophy/reasoning behind this file, please see https://openfolder.sh/macos-migrations-with-brewfile

# There are some common shell aliases that I have setup in the `${ZDOTDIR}/.aliases` file for ease of running/typing (and also don't need to remember all those commands by-heart!). If you are using my `${ZDOTDIR}/.aliases`, they will already be present for you.

# TODO: Need to find cask for:
#   Tinkertool
#   TypeWhisper (start on login)
#   ZoomHider

# set global preferences for all 'brew install' commands
cask_args appdir: '/Applications', fontdir: '/Library/Fonts', adopt: true

# java_present = system('/usr/libexec/java_home --failfast')
is_arm = ::Hardware::CPU.arm?
is_beta_os = ::OS::Mac::full_version.unsupported_release?

# Whether Keybase support is enabled -- mirrors '.shellrc's KEYBASE_HOME_REPO_NAME/
# KEYBASE_PROFILES_REPO_NAME exports. Comment out those exports in .shellrc to disable
# the cask below entirely.
#
# NOTE: 'brew bundle' does NOT inherit arbitrary environment variables from the invoking
# shell (only a small allowlist like HOME/PATH survives into this Ruby DSL's ENV), so we
# read '.shellrc' directly -- the actual source of truth the comment above tells users to edit.
shellrc_path = File.expand_path('~/.shellrc')
shellrc_content = File.exist?(shellrc_path) ? File.read(shellrc_path) : ''
keybase_enabled = shellrc_content.match?(/^\s*export\s+KEYBASE_(?:HOME|PROFILES)_REPO_NAME=\S/)

# Whether the gpg+git-bundle encrypted backup is enabled -- mirrors '.shellrc's
# ENCRYPTED_HOME_REPO_URL/ENCRYPTED_PROFILES_REPO_URL exports. Comment out those exports
# in .shellrc to disable the formula below. Same '.shellrc'-direct-read rationale as above.
encrypted_backup_enabled = shellrc_content.match?(/^\s*export\s+ENCRYPTED_(?:HOME|PROFILES)_REPO_URL=\S/)

# TODO: Hardcoding of the dotfiles repo folder - since that env var is not available inside this env
setup_login_items_script = "${HOME}/.config/dotfiles/scripts/setup-login-item.rb"

# These casks must come first -- required for manual login during a vanilla OS installation.
cask 'font-meslo-lg-nerd-font'
if keybase_enabled
  cask 'keybase',
    postinstall: "\"#{setup_login_items_script}\" -a 'Keybase' && " \
                 "ln -sf '/Applications/Keybase.app/Contents/SharedSupport/bin/keybase' \"${HOMEBREW_PREFIX}/bin/keybase\" && " \
                 "ln -sf '/Applications/Keybase.app/Contents/SharedSupport/bin/git-remote-keybase' \"${HOMEBREW_PREFIX}/bin/git-remote-keybase\""
end

# formulae pulled in from homebrew to replace system equivalents to fix any security issues since the OS was released
# This list is enhanced from https://macgnu.codewithshin.com/?id=gnu-programs-existing-in-macos-which-are-outdated
brew 'bash'
brew 'curl'
brew 'git'
brew 'grep'
brew 'jemalloc'  # used for faster ruby
brew 'less'
brew 'libyaml'  # used for faster ruby
brew 'openssl', link: true  # used for faster ruby
brew 'rsync'
brew 'sqlite3'
brew 'vim'
brew 'wget'
brew 'zsh'

if encrypted_backup_enabled
  brew 'vraravam/tap/git-remote-gpg-encrypt', trusted: true  # encrypted backup (gpg + git bundle, coexists with Keybase)
end

# formulae pulled in for base configs (if these are absent, you will get errors and things won't work)
brew 'antidote',
  postinstall: "[ -f '${ZDOTDIR}/.aliases' ] && zsh -c 'source ${ZDOTDIR}/.aliases && update_antidote_and_regenerate_plugin_bundle' || true"
brew 'delta'
brew 'direnv'
brew 'eza'
brew 'git-extras',
  postinstall: "rm -rf \"${HOMEBREW_REPOSITORY}/share/zsh/site-functions/_git\" 2>/dev/null || true"
brew 'git-tools'
brew 'git-trim'
brew 'mise'
brew 'starship'
brew 'terminal-notifier', postinstall: "xattr -rd com.apple.quarantine \"${HOMEBREW_PREFIX}/opt/terminal-notifier/terminal-notifier.app\""
brew 'zsh-patina',  # Rust-based syntax highlighter for cli
  postinstall: 'zsh-patina restart >/dev/null 2>&1 || true'

# casks pulled in for base configs (if these are absent, you will get errors and things won't work)
cask 'iterm2@beta'

# FIRST_INSTALL: While re-imaging the OS or setting up for the first time, install only the bare minimum apps/utilities above this line so that the rest of the backup restoration can proceed faster.

